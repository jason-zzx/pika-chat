# Copy to .env and fill in secrets before first run.
# Generate secrets with: openssl rand -base64 48

DATABASE_URL=postgres://pika:pika@localhost:5432/pika_chat
TEST_DATABASE_URL=postgres://pika:pika@localhost:5432/pika_chat_test

# Authenticated encryption key for provider API credentials (AES-256-GCM).
# Losing this secret permanently orphans every stored provider key. It cannot
# be recovered from the database.
CREDENTIAL_ENCRYPTION_SECRET=replace-with-at-least-32-characters

# Better Auth session signing secret. Auth wiring lands in a later task;
# the variable must exist so the environment contract is stable.
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
