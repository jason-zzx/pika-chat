# Copy to .env and fill in secrets before first run.
# Generate secrets with: openssl rand -base64 48

DATABASE_URL=postgres://pika:pika@localhost:5432/pika_chat
TEST_DATABASE_URL=postgres://pika:pika@localhost:5432/pika_chat_test

# Authenticated encryption key for provider API credentials (AES-256-GCM).
# Losing this secret permanently orphans every stored provider key. It cannot
# be recovered from the database.
CREDENTIAL_ENCRYPTION_SECRET=replace-with-at-least-32-characters

# Better Auth session signing secret. Rotating it invalidates every
# existing session; it is not data loss, but everyone will need to sign in
# again.
BETTER_AUTH_SECRET=replace-with-at-least-32-characters

# Public URL of this instance. Defaults to http://localhost:3000 in development.
# BETTER_AUTH_URL=http://localhost:3000

# Directory for locally stored chat attachments. Defaults to .data/files.
# Mount a persistent volume here in production.
# FILE_STORAGE_DIR=/data/files

# Largest single chat attachment, in MiB (1–100). Defaults to 20. Values
# outside the range fail at startup rather than being clamped.
# FILE_UPLOAD_MAX_MB=20

# S3-compatible attachment storage. All optional: S3_BUCKET is the switch —
# set it and attachments go to object storage, leave it unset and they stay on
# local disk. The bucket is created on first use. Never commit real values.
# S3_BUCKET=pika-attachments
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Direct client-to-S3 byte transfer, both directions: the browser uploads
# with a presigned POST policy and downloads/previews via a 302 to a presigned
# GET, so bytes never pass through the app. "1" or "true" turns it on; unset
# keeps the server-side relay. Requires S3_BUCKET: enabling it without S3 makes
# the server refuse to start rather than silently falling back to the relay.
# Direct uploads also need the bucket's CORS to allow browser POSTs.
# S3_DIRECT_ACCESS=1

