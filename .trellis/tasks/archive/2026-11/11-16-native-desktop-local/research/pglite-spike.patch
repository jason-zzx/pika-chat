diff --git a/spike/concurrency.mjs b/spike/concurrency.mjs
new file mode 100644
index 0000000..8a61465
--- /dev/null
+++ b/spike/concurrency.mjs
@@ -0,0 +1,43 @@
+import { PGlite } from "@electric-sql/pglite";
+import { sql } from "drizzle-orm";
+import { drizzle } from "drizzle-orm/pglite";
+
+const db = drizzle(await PGlite.create("memory://"));
+await db.execute(sql`create table t (id int primary key, v int)`);
+await db.execute(sql`insert into t select g, 0 from generate_series(1, 200000) g`);
+
+// 1. Outer-db query inside a transaction callback.
+const nested = db.transaction(async (tx) => {
+  await tx.execute(sql`update t set v = 1 where id = 1`);
+  await db.execute(sql`select 1`);
+});
+const outcome = await Promise.race([
+  nested.then(() => "completed"),
+  new Promise((r) => setTimeout(() => r("hung > 3s (deadlock)"), 3000)),
+]);
+console.log("1. getDb() inside transaction:", outcome);
+process.exit !== undefined;
+
+// 2. Event-loop starvation: a timer that should fire every 10ms while a
+// heavy query runs on the same thread.
+const db2 = drizzle(await PGlite.create("memory://"));
+await db2.execute(sql`create table t (id int primary key, v int)`);
+await db2.execute(sql`insert into t select g, 0 from generate_series(1, 200000) g`);
+let ticks = 0;
+const timer = setInterval(() => ticks++, 10);
+const started = performance.now();
+await db2.execute(sql`select count(*) from t a, generate_series(1, 30) g where a.v + g > 0`);
+const elapsed = Math.round(performance.now() - started);
+clearInterval(timer);
+console.log(`2. heavy query ${elapsed}ms, 10ms timer fired ${ticks}x (expected ~${Math.round(elapsed / 10)})`);
+
+// 3. Throughput of short serialized transactions while a long one waits on I/O.
+const longTx = db2.transaction(async (tx) => {
+  await tx.execute(sql`update t set v = 2 where id = 1`);
+  await new Promise((r) => setTimeout(r, 1000)); // e.g. awaiting a provider call
+});
+const t0 = performance.now();
+await db2.execute(sql`select 1`);
+console.log(`3. plain query issued during a 1s transaction waited ${Math.round(performance.now() - t0)}ms`);
+await longTx;
+process.exit(0);
