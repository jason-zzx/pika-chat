diff --git a/spike/scan_tx.py b/spike/scan_tx.py
new file mode 100644
index 0000000..b2543f2
--- /dev/null
+++ b/spike/scan_tx.py
@@ -0,0 +1,21 @@
+import glob
+import re
+
+for f in glob.glob("src/server/**/*.ts", recursive=True):
+    if ".test." in f:
+        continue
+    s = open(f).read()
+    for m in re.finditer(r"function (\w+)\(([^)]*?)\)[^{]*\{", s, re.S):
+        params = m.group(2)
+        if not re.search(r"DbTransaction|Executor|\btx\b", params):
+            continue
+        i = m.end()
+        depth = 1
+        while depth and i < len(s):
+            depth += {"{": 1, "}": -1}.get(s[i], 0)
+            i += 1
+        body = s[m.end() : i]
+        calls = [l.strip() for l in body.split("\n") if "getDb()" in l]
+        if calls:
+            line = s[: m.start()].count("\n") + 1
+            print(f"{f}:{line}", m.group(1), calls)
diff --git a/spike/types-probe.ts b/spike/types-probe.ts
new file mode 100644
index 0000000..1a96805
--- /dev/null
+++ b/spike/types-probe.ts
@@ -0,0 +1,38 @@
+import { sql } from "drizzle-orm";
+import type { PgDatabase, PgQueryResultHKT } from "drizzle-orm/pg-core";
+import type { PgliteDatabase } from "drizzle-orm/pglite";
+import type { PostgresJsDatabase } from "drizzle-orm/postgres-js";
+
+import * as schema from "@/server/db/schema";
+
+type Schema = typeof schema;
+declare const lite: PgliteDatabase<Schema>;
+declare const pgjs: PostgresJsDatabase<Schema>;
+
+// 1. Union client: does transaction() remain callable?
+declare const union: PgliteDatabase<Schema> | PostgresJsDatabase<Schema>;
+await union.transaction(async (tx) => {
+  await tx.select().from(schema.users);
+});
+
+// 2. Common base type both drivers extend.
+type Common = PgDatabase<PgQueryResultHKT, Schema>;
+const a: Common = lite;
+const b: Common = pgjs;
+await a.transaction(async (tx) => {
+  await tx.select().from(schema.users).for("update");
+});
+
+// 3. execute() result shape differs per driver.
+const fromLite = await lite.execute<{ now: Date }>(sql`select now()`);
+fromLite.rows[0]?.now;
+const fromPgjs = await pgjs.execute<{ now: Date }>(sql`select now()`);
+fromPgjs[0]?.now;
+const fromCommon = await b.execute(sql`select now()`);
+// @ts-expect-error -- base HKT result is unknown, neither [0] nor .rows typed
+fromCommon[0];
+
+// 4. Cross-assignment between drivers.
+// @ts-expect-error -- PGlite db is not a postgres-js db
+const c: PostgresJsDatabase<Schema> = lite;
+void c;
